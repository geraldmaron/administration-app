{
  "name": "@admin/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b && cp src/preload.cjs dist/preload.cjs",
    "start": "tsc -b && cp src/preload.cjs dist/preload.cjs && electron .",
    "package": "tsc -b && cp src/preload.cjs dist/preload.cjs && electron-forge package",
    "make": "tsc -b && cp src/preload.cjs dist/preload.cjs && electron-forge make",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "optionalDependencies": {
    "steamworks.js": "^0.4.0"
  },
  "devDependencies": {
    "@admin/player-core": "workspace:*",
    "@electron-forge/cli": "^7.8.1",
    "@electron-forge/maker-dmg": "^7.8.1",
    "@electron-forge/maker-squirrel": "^7.8.1",
    "@electron-forge/maker-zip": "^7.8.1",
    "@types/node": "^22.18.0",
    "electron": "^37.3.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
