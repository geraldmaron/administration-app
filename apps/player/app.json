{
  "expo": {
    "name": "The Administration",
    "slug": "the-administration",
    "scheme": "administration",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "../../assets/player/brand/icon.png",
    "ios": {
      "bundleIdentifier": "com.theadministration.player",
      "supportsTablet": true
    },
    "android": {
      "package": "com.theadministration.player",
      "adaptiveIcon": {
        "foregroundImage": "../../assets/player/brand/adaptive-foreground.png",
        "backgroundColor": "#0E1218"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "../../assets/player/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "../../assets/player/brand/splash-icon.png",
          "backgroundColor": "#07090D",
          "imageWidth": 160
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E2B562"
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
