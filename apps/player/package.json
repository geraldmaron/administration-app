{
  "name": "@admin/player",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "node scripts/copy-maplibre.mjs && expo start",
    "web": "node scripts/copy-maplibre.mjs && expo start --web",
    "export:web": "node scripts/copy-maplibre.mjs && expo export --platform web --output-dir dist",
    "export:native": "expo export --platform ios --platform android --output-dir dist-native",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src",
    "test": "vitest run --passWithNoTests",
    "assets": "node scripts/copy-maplibre.mjs"
  },
  "dependencies": {
    "@admin/content": "workspace:*",
    "@admin/design": "workspace:*",
    "@admin/engine": "workspace:*",
    "@admin/player-core": "workspace:*",
    "@admin/ui": "workspace:*",
    "@admin/world": "workspace:*",
    "@expo-google-fonts/source-sans-3": "0.4.2",
    "@expo-google-fonts/source-serif-4": "0.4.2",
    "@expo/metro-runtime": "~58.0.14",
    "@maplibre/maplibre-react-native": "11.5.0",
    "d3-geo": "^3.1.1",
    "expo": "58.0.11",
    "expo-blur": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.8",
    "expo-haptics": "~58.0.6",
    "expo-image": "~58.0.15",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-notifications": "~58.1.4",
    "expo-router": "~58.0.20",
    "expo-splash-screen": "~58.0.9",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "maplibre-gl": "6.11.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@types/react": "~19.3.0",
    "@types/geojson": "^7946.0.16",
    "@types/topojson-client": "^3.1.5",
    "@types/d3-geo": "^3.1.0"
  }
}
